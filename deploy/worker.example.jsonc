{
  // Copy to worker.production.jsonc (ignored by Git), then fill your own IDs.
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "momento-production",
  "main": "../production-dist/worker.js",
  "compatibility_date": "2026-10-19",
  "workers_dev": true,
  "assets": {
    "directory": "../production-dist/public",
    "binding": "PUBLIC_ASSETS",
    "run_worker_first": true,
    "not_found_handling": "none"
  },
  "vars": {
    "MOMENTO_APP_ORIGIN": "https://REPLACE_WITH_YOUR_DOMAIN",
    "SUPABASE_URL": "https://REPLACE_WITH_MOMENTO_PROJECT_REF.supabase.co",
    "SUPABASE_DATA_ENABLED": "true",
    "AUTH_OAUTH_PROVIDERS": "",
    "AUTH_EMAIL_ENABLED": "false",
    "AUTH_EMAIL_MODE": "basic",
    "AUTH_EMAIL_DAILY_BUDGET": "20",
    "AUTH_SMS_ENABLED": "false",
    "AUTH_SMS_DAILY_BUDGET": "20",
    "MOMENTO_ADMIN_USER_IDS": "",
    "VIDEO_PROVIDER": "livekit",
    "LIVE_EVENTS_ENABLED": "false",
    "VIDEO_VALIDATED": "false",
    "LEGAL_VALIDATED": "false"
  },
  // Secrets are entered with Wrangler secret put, never in this file:
  // SUPABASE_PUBLISHABLE_KEY, SUPABASE_SECRET_KEY, AUTH_COOKIE_SECRET (32+ random chars),
  // LIVEKIT_URL, LIVEKIT_API_KEY, LIVEKIT_API_SECRET, and Stripe TEST keys.
  "observability": {"enabled": false}
}
